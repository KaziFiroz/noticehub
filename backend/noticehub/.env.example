# Copy this file to `.env` (or export these as real environment variables)
# and fill in your own local values. `.env` is git-ignored and will never
# be committed.
#
# Spring Boot does not read .env files by itself — either:
#   1) export these in your shell before running `mvnw spring-boot:run`, or
#   2) set them in your IDE's run configuration, or
#   3) use a tool like `direnv` / `dotenv-java` to load this file.

DB_URL=jdbc:mysql://localhost:3306/noticehub_db
DB_USERNAME=noticehub_user
DB_PASSWORD=choose_your_own_local_password

# Generate a real random 256-bit secret for JWT signing, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=86400000
